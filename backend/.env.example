DATABASE_URL=sqlite:///./contextsense.db
SPACY_MODEL=en_core_web_sm
EMBED_MODEL=all-MiniLM-L6-v2
USE_EMBEDDINGS=1
# Optional: use a transformer sentiment model in addition to the contextual lexicon rules
USE_TRANSFORMERS=0
SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
CORS_ORIGINS=http://localhost:5173
